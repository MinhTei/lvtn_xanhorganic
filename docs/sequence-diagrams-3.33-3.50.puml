@startuml Fig_3_39
title Hình 3.39 — Thanh toán đơn hàng
actor "Khách hàng" as A
boundary "Trang Giỏ hàng" as Cart
boundary "Trang Thanh toán" as B
boundary "Thanh toán VNPay" as G
control "CheckoutController" as C
entity "Order" as E

A -> Cart : 1. Tiến hành đặt hàng
Cart -> C : 1.1. index()
C --> B : 1.1.1. return checkoutForm

A -> B : 2. Điền đầy đủ thông tin và phương thức thanh toán
B -> C : 2.1. store()
C -> C : 2.1.1. validate()

alt Thành công
  alt COD
    C -> E : 2.1.2. createOrder()
    E --> C : 2.1.2.1. Tạo đơn hàng thành công
    C --> B : 2.1.3. Thông báo đặt hàng thành công và gửi email
  else VNPay
    C -> E : 2.1.2. createOrder()
    note right of E
      Tạo đơn trước khi\nchuyển sang VNPay
    end note
    E --> C : 2.1.2.1. Tạo đơn hàng thành công
    C --> G : 2.1.3. return vnpayForm
    A -> G : 2.1.4. Nhập thông tin thanh toán VNPay
    G -> C : 2.1.5. applyPaymentResult()
    alt Thanh toán thành công
      C -> E : 2.1.5.1. updatePayment()
      C --> B : 2.1.5.2. Thông báo thanh toán thành công và gửi email
    else Thanh toán thất bại
      C -> E : 2.1.5.1. cancelOrder()
      note right of E
        Hủy đơn; hoàn kho;\nkhôi phục giỏ hàng
      end note
      C --> B : 2.1.5.2. Thanh toán không thành công
    end
  end
else Không hợp lệ
  C --> B : 2.1.2. Thông báo lỗi
end
@enduml

