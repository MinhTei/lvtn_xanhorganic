@startuml Fig_3_13
title Hình 3.13 — Đăng nhập người dùng
actor "Người dùng" as A
boundary "Trang Chủ" as H
boundary "Trang Đăng Nhập" as B
control "AuthController" as C
entity "User" as E

A -> H : 1. Truy cập trang chủ
H -> B : 1.1. Truy cập trang đăng nhập
B -> C : 1.1.1. showLoginForm()
C --> B : 1.1.1.1. return loginForm

A -> B : 2. Nhập email và mật khẩu
B -> C : 2.1. login()
C -> C : 2.1.1. validate()
C -> E : 2.1.1.1. loginUser()
E --> C : 2.1.1.2. return user

alt Thành công
  C -> C : 2.1.2. Tạo session
  alt Admin / Staff
    C --> A : 2.1.3. Chuyển /admin
  else Customer
    C -> C : 2.1.3. Gộp giỏ hàng / yêu thích
    C --> H : 2.1.4. Thông báo đăng nhập thành công
  end
else Không thành công
  C --> B : 2.1.2. Thông báo sai TK / MK hoặc chưa kích hoạt
end
@enduml

@startuml Fig_3_14
title Hình 3.14 — Đăng ký tài khoản
actor "Người dùng" as A
boundary "Trang Chủ" as H
boundary "Trang Đăng Ký" as B
control "AuthController" as C
entity "User" as E

A -> H : 1. Truy cập trang chủ
H -> B : 1.1. Mở trang đăng ký
B -> C : 1.1.1. showRegisterForm()
C --> B : 1.1.1.1. return registerForm

A -> B : 2. Điền thông tin và Đăng ký
B -> C : 2.1. register()
C -> C : 2.1.1. validate()
C -> E : 2.1.1.1. checkEmailExist()
E --> C : 2.1.1.2. return result

alt Thành công
  C -> E : 2.1.2. createUser()
  E --> C : 2.1.2.1. return user
  C --> B : 2.1.3. Thông báo kiểm tra email
  A -> C : 3. activate(token)
  C -> E : 3.1. activateUser()
  C --> A : 3.2. Chuyển trang đăng nhập
else Email trùng / lỗi
  C --> B : 2.1.2. Thông báo lỗi
end
@enduml

@startuml Fig_3_15
title Hình 3.15 — Quên mật khẩu
actor "Người dùng" as A
boundary "Trang Đăng Nhập" as L
boundary "Trang Quên MK" as F
boundary "Trang Đặt lại MK" as R
