@startuml Fig_3_32
title Hình 3.32 — Xóa danh mục
actor "Admin" as A
boundary "Trang Quản lý danh mục" as B
control "AdminCategoryController" as C
entity "Category" as E
entity "Product" as P

A -> B : 1. Nhấn Xóa
B -> C : 1.1. destroy()
alt Có quyền manage_categories
  C -> E : 1.1.1. checkHasProducts()
  E -> P : 1.1.1.1. exists()
  P --> E : 1.1.1.2. return hasProducts
  E --> C : 1.1.1.3. return hasProducts
  alt Còn sản phẩm
    C --> B : 1.1.2. Không xóa được
  else Không có sản phẩm
    C -> E : 1.1.2. checkHasChildren()
    E --> C : 1.1.2.1. return hasChildren
    alt Còn danh mục con
      C --> B : 1.1.3. Không xóa được
    else Không có danh mục con
      C -> E : 1.1.3. delete()
      C --> B : 1.1.4. Thông báo đã xóa
    end
  end
else Không có quyền
  C --> B : 1.1.1. Thông báo không có quyền
end
@enduml
