@startuml Fig_3_23
title Hình 3.23 — Khóa / mở khóa tài khoản
actor "Admin" as A
boundary "Trang QL người dùng" as B
control "AdminUserController" as C
entity "User" as E

A -> B : 1. Nhấn Khóa hoặc Mở khóa
B -> C : 1.1. toggleBlock()
alt Có quyền manage_users
  C -> C : 1.1.1. Kiểm tra điều kiện
  alt Đang active
    C -> E : 1.1.1.1. update(status=blocked)
    E --> C : 1.1.1.2. return
    C --> B : 1.1.2. Thông báo đã khóa
  else Đang blocked
    C -> E : 1.1.1.1. update(status=active)
    E --> C : 1.1.1.2. return
    C --> B : 1.1.2. Thông báo đã mở khóa
  else Không hợp lệ
    C --> B : 1.1.1.1. Thông báo lỗi\\n(tự khóa / chưa kích hoạt / khóa admin)
  end
else Không có quyền
  C --> B : 1.1.1. Thông báo không có quyền
end
@enduml

